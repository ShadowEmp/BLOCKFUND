# ==========================================
# Unified Environment Variables
# Copy this file to '.env' at the project root
# ==========================================

# ------------------------------------------
# 1. Shared / Backend Environment
# ------------------------------------------
# The port the backend server will run on (Usually keep as 5000)
PORT=5000

# The connection string for your PostgreSQL database.
# If using the provided docker-compose stack, this default works perfectly.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crowdfunding_db

# Make up any random string here (e.g. "super_secret_key_123"). It is used to securely sign user logins.
JWT_SECRET=your_jwt_secret_key_here

# Go to https://app.pinata.cloud/developers/api-keys to create a free account and generate an API API Key.
PINATA_API_KEY=your_pinata_api_key

# Found right next to the PINATA_API_KEY when generating your key on Pinata.
PINATA_SECRET_KEY=your_pinata_secret_key

# Create a free account at https://dashboard.alchemy.com/, create an app on "Polygon Amoy", and paste the HTTPS RPC URL here.
POLYGON_AMOY_RPC=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# AFTER you run "npx hardhat run scripts/deploy.js --network amoy", the console will output an address. Paste it here.
CONTRACT_ADDRESS=your_deployed_contract_address

# Open MetaMask -> Account Details -> Export Private Key. (DO NOT SHARE THIS WITH ANYONE OUTSIDE THIS FILE)
PRIVATE_KEY=your_metamask_private_key_here

# (Optional) Go to https://polygonscan.com/myapikey to get a key to verify your deployed code on the block explorer.
POLYGONSCAN_API_KEY=

# ------------------------------------------
# 2. Frontend Environment (Must start with VITE_)
# ------------------------------------------
# The URL pointing to your running backend API (Keep default for local dev)
VITE_BACKEND_URL=http://localhost:5000/api

# Paste the EXACT SAME address as CONTRACT_ADDRESS above.
VITE_CONTRACT_ADDRESS=your_deployed_contract_address

# Paste the EXACT SAME url as POLYGON_AMOY_RPC above (needed for MetaMask auto-network addition).
VITE_POLYGON_AMOY_RPC=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
